{
  "version": 1,
  "mode": "motion",
  "theme": "light",
  "defaultLanguage": "en",
  "languages": [
    "en",
    "zh"
  ],
  "styleRouting": {
    "contract": "recommendation-not-validation",
    "supported": "Every registered layout remains technically compatible with every registered palette and theme for non-closing scenes. End cards use Light/neutral only.",
    "rules": [
      {
        "purpose": "opening",
        "layouts": [
          "motion-title",
          "motion-brand"
        ],
        "preferred": [
          "light/neutral",
          "dark/teal",
          "dark/cobalt"
        ],
        "avoidByDefault": [
          "light/lime"
        ],
        "reason": "Open with the quiet light system or a solid brand-color identity beat."
      },
      {
        "purpose": "closing",
        "layouts": ["motion-title", "motion-brand"],
        "preferred": ["light/neutral"],
        "reason": "End cards explicitly override deck defaults with Light/neutral. No Dark or bright-lime endings, whether Logo-only, Logo + CTA, or a statement."
      },
      {
        "purpose": "large-number-or-keyword",
        "layouts": [
          "motion-metric",
          "motion-title"
        ],
        "preferred": [
          "light/lime",
          "light/neutral",
          "dark/teal",
          "dark/cobalt"
        ],
        "reason": "Bright lime is a high-emphasis field best reserved for one large focal value or phrase."
      },
      {
        "purpose": "ordered-list",
        "layouts": [
          "motion-list"
        ],
        "preferred": [
          "dark/teal",
          "dark/cobalt",
          "light/neutral"
        ],
        "avoidByDefault": [
          "light/lime"
        ],
        "reason": "Lists read best on a stable solid brand field; lime remains an explicit exception."
      },
      {
        "purpose": "information-scene",
        "layouts": [
          "motion-cards",
          "motion-comparison",
          "motion-input",
          "motion-synthesis",
          "motion-hub",
          "motion-workflow",
          "motion-image"
        ],
        "preferred": [
          "light/neutral",
          "dark/neutral",
          "dark/teal",
          "dark/cobalt"
        ],
        "reason": "Use calm neutral or solid brand backgrounds for sustained reading."
      }
    ],
    "selection": "Choose layout from information meaning first, then choose the first preferred style compatible with the narrative beat. Do not rotate palettes for variety. An explicit lower-priority combination remains valid and should be documented in notes.purpose."
  },
  "layouts": {
    "motion-title": {
      "variants": [
        "statement",
        "brand-title"
      ],
      "maxLines": 2,
      "duration": 3,
      "fields": [
        "title",
        "highlight",
        "kicker",
        "logos",
        "separator",
        "body"
      ],
      "purpose": "One memorable statement or section beat"
    },
    "motion-brand": {
      "variants": [
        "single",
        "pair",
        "cta"
      ],
      "counts": [
        1,
        2
      ],
      "duration": 2,
      "fields": [
        "logos",
        "separator",
        "label",
        "cta"
      ],
      "purpose": "Single/pair identity, or logos plus an independent CTA; not a giant closing title"
    },
    "motion-cards": {
      "variants": [
        "standard"
      ],
      "counts": [
        2,
        3,
        4
      ],
      "duration": 5,
      "fields": [
        "title",
        "kicker",
        "items"
      ],
      "purpose": "Parallel concise points"
    },
    "motion-comparison": {
      "variants": [
        "before-after"
      ],
      "counts": [
        2
      ],
      "duration": 5,
      "fields": [
        "title",
        "kicker",
        "items"
      ],
      "purpose": "Muted baseline paired with a stronger fill/stroke target; gradient emphasis is optional, not assumed"
    },
    "motion-input": {
      "variants": [
        "multiline",
        "compact"
      ],
      "duration": 4,
      "fields": [
        "prompt",
        "label",
        "image",
        "showCursor",
        "showSend",
        "send",
        "showCaret"
      ],
      "purpose": "A prompt entered into a conceptual UI"
    },
    "motion-list": {
      "variants": [
        "plain",
        "checked"
      ],
      "counts": {
        "min": 1,
        "max": 24
      },
      "duration": 6,
      "fields": [
        "items",
        "image",
        "scroll",
        "showLogo"
      ],
      "purpose": "Full off-canvas list with replaceable identity; animation suggestions only, no internal scroll window"
    },
    "motion-synthesis": {
      "variants": [
        "stages",
        "many-to-few"
      ],
      "duration": 5,
      "fields": [
        "title",
        "kicker",
        "groups",
        "outputs",
        "composition",
        "result"
      ],
      "groupCounts": [
        1,
        2,
        3,
        4
      ],
      "purpose": "Information groups consolidated into outcomes; typography is semantic, never assigned by column index"
    },
    "motion-hub": {
      "variants": [
        "one",
        "two",
        "three",
        "four"
      ],
      "counts": [
        1,
        2,
        3,
        4
      ],
      "duration": 5,
      "fields": [
        "title",
        "kicker",
        "hub",
        "items",
        "connections"
      ],
      "purpose": "One to four satellites with explicit hub-to-node connections and immutable Joint geometry"
    },
    "motion-image": {
      "variants": [
        "split",
        "hero"
      ],
      "duration": 4,
      "fields": [
        "title",
        "kicker",
        "body",
        "image"
      ],
      "purpose": "User image or screenshot; split always left text and right image",
      "extension": true
    },
    "motion-metric": {
      "variants": [
        "single",
        "hero-number",
        "hero-word",
        "cards"
      ],
      "duration": 3,
      "fields": [
        "title",
        "value",
        "label",
        "body",
        "items"
      ],
      "purpose": "One focal value/keyword, or two independent equal-weight metric cards; never merge separate measures into one slash-delimited string",
      "extension": true
    },
    "motion-workflow": {
      "variants": [
        "left-to-right",
        "rows"
      ],
      "counts": [
        2,
        3,
        4
      ],
      "duration": 5,
      "fields": [
        "title",
        "kicker",
        "items",
        "connections",
        "rows"
      ],
      "purpose": "Ordered left-to-right steps with independent original arrows; no central node",
      "extension": true
    }
  },
  "components": {
    "heading": {
      "alignment": "center",
      "width": 1700,
      "height": "hug",
      "roles": [
        "kicker",
        "display"
      ],
      "maxLines": 1
    },
    "statement": {
      "alignment": "center",
      "width": 1700,
      "height": "hug",
      "role": "statement",
      "maxLines": 2
    },
    "pointCard": {
      "height": 450,
      "width": "fill",
      "padding": 30,
      "radius": 20,
      "roles": [
        "label",
        "item",
        "body"
      ],
      "labelOptional": true,
      "bodyMaxLines": 3
    },
    "listRow": {
      "height": "hug",
      "minHeight": 137,
      "width": "fill",
      "padding": 20,
      "radius": 20,
      "roles": [
        "list",
        "body"
      ],
      "badgeOptional": true,
      "iconOptional": true
    },
    "synthesis": {
      "defaultsToken": "synthesis.defaults",
      "arrangements": [
        "columns",
        "rows",
        "wrap"
      ],
      "tagWidth": [
        "fill",
        "hug"
      ],
      "align": [
        "left",
        "center"
      ],
      "groupAlign": [
        "start",
        "center"
      ],
      "density": [
        "comfortable",
        "compact"
      ],
      "measurement": "Equal-width columns or per-row cells measured from live text after fonts load; never shrink text to force fit",
      "height": "hug",
      "maxInputGroups": 4,
      "maxTagsPerGroup": 4,
      "outputs": [
        1,
        2,
        3
      ]
    },
    "tag": {
      "width": "fill in aligned grids; hug in wrap/explicit hug mode; text always hugs",
      "height": "hug",
      "sizes": {
        "small": {
          "fontSize": 24,
          "padding": 12,
          "radius": 8
        },
        "medium": {
          "fontSize": 30,
          "padding": 16,
          "radius": 16
        },
        "large": {
          "fontSize": 50,
          "padding": 16,
          "radius": 24
        }
      },
      "themeTreatment": {
        "light": "Six semantic colors; use only meaningful categories, not a color per tag.",
        "dark": "Neutral white text / 8% white fill; accent brand cyan text / 4% cyan fill. Legacy info/success/warning/purple names resolve to neutral, not opaque colored chips. Single output uses the same accent, never the Light gradient."
      },
      "tones": [
        "neutral",
        "info",
        "success",
        "warning",
        "purple",
        "accent"
      ]
    },
    "input": {
      "height": "hug",
      "width": 900,
      "minWidth": 452,
      "maxWidth": 1273,
      "padding": 24,
      "radius": 40,
      "send": {
        "states": [
          "default",
          "hover",
          "pressed",
          "sent",
          "disabled"
        ],
        "token": "send.states",
        "targets": [
          "input",
          "input-surface",
          "input-logo",
          "input-label",
          "prompt",
          "send",
          "send-icon",
          "cursor",
          "prompt-text",
          "caret"
        ],
        "click": "aident:send; no network submission or automatic state transition"
      },
      "caret": {
        "optional": true,
        "default": false,
        "field": "showCaret",
        "target": "caret",
        "typing": "AIDENT_MOTION.setPromptText(slideId,text)",
        "animation": "external; no blink"
      }
    },
    "logo": {
      "fit": "contain",
      "stretch": false,
      "crop": false,
      "slots": {
        "brand": {
          "single": {
            "maxWidth": 777,
            "maxHeight": 147
          },
          "pair": {
            "maxWidth": 597,
            "maxHeight": 113.062
          },
          "gap": 64
        },
        "list": 150,
        "hub": 80,
        "satellite": 46,
        "input": 60,
        "title": {
          "maxWidth": 420,
          "maxHeight": 80,
          "gap": 32
        }
      },
      "pairTargets": [
        "logo-0",
        "separator",
        "logo-1"
      ],
      "placeholder": {
        "content": "live editable text, not a brand image",
        "width": 440,
        "minHeight": 144,
        "padding": 24,
        "fields": [
          "placeholder",
          "caption"
        ],
        "replacement": "replace entire entry with image object",
        "pairRule": "Never split one identity into symbol × wordmark"
      },
      "identity": {
        "brandDefault": "assets/motion/lockup.svg",
        "compactDefault": "assets/motion/mark.svg",
        "allowed": "approved complete lockup or standalone graphic; no extracted text-only identity",
        "replacement": "both pair slots independent; preserve original ratio; no invented partners"
      }
    },
    "connector": {
      "asset": "original exported vector",
      "layer": "behind content",
      "separate": true,
      "sizing": "intrinsic; mirror only; never stretch or skew",
      "fit": "contain",
      "binding": "content-hugging cards move to dock at fixed-size connector endpoints",
      "topology": "Hub-to-satellite only; one edge per satellite; 1–4 satellites; explicit unique slots optional"
    },
    "listScene": {
      "clip": false,
      "height": "hug",
      "cameraClip": "slide boundary only",
      "identityTop": 200,
      "trackTopWithLogo": 417,
      "defaultLogo": "assets/motion/mark.svg",
      "animation": "suggestions only; external animator owns distance, timing and camera"
    },
    "workflow": {
      "direction": "left-to-right",
      "counts": [
        2,
        3,
        4
      ],
      "gap": 24,
      "padding": 24,
      "nodeWidth": "equal Fill, maximum440",
      "nodeHeight": "shared tallest, text hug",
      "connector": "original167×22.0919; independent; no stretch",
      "edgeCount": "nodeCount-1",
      "rows": {
        "top": 370,
        "width": 1700,
        "maxHeight": 610,
        "rowGap": 24,
        "nodePadding": 24,
        "maxRows": 3,
        "minNodes": 2,
        "maxNodes": 4
      }
    },
    "result": {
      "variants": [
        "table",
        "list"
      ],
      "columns": [
        2,
        3,
        4
      ],
      "rows": [
        1,
        2,
        3,
        4
      ],
      "width": 840,
      "captionOptional": true
    },
    "theme": {
      "scope": "all-motion-layouts-and-variants",
      "inheritance": [
        "slide",
        "meta",
        "default"
      ],
      "sharedFields": [
        "theme",
        "palette",
        "background"
      ],
      "backgroundScope": "slide-only; inferred from resolved palette and layout when omitted",
      "preserveLayout": true,
      "default": "light",
      "override": "meta.theme / slide.theme",
      "assets": "image.variants.light/dark; missing requested variant is an error; never invert a brand or add a plaque",
      "palette": "meta.palette / slide.palette: neutral, teal, cobalt, lime",
      "backgrounds": [
        "content",
        "title",
        "elements",
        "solid",
        "brand",
        "brand-gradient"
      ]
    },
    "metric": {
      "cards": {
        "count": 2,
        "fields": [
          "value",
          "label",
          "body"
        ],
        "alignment": "left",
        "independentLayers": true
      },
      "variants": [
        "single",
        "hero-number",
        "hero-word",
        "cards"
      ]
    },
    "cta": {
      "defaultTheme": "light",
      "endingPalette": "neutral",
      "closingPolicy": "Light/neutral only; no Dark or bright-lime endings, with or without CTA",
      "logos": [
        1,
        2
      ],
      "fields": [
        "text",
        "href",
        "showArrow"
      ],
      "optionalLabel": true,
      "heading": false,
      "body": false,
      "editableTargets": [
        "cta",
        "cta-text",
        "cta-arrow",
        "cta-label",
        "logo-0",
        "logo-1"
      ],
      "timing": "external"
    }
  },
  "themes": [
    "light",
    "dark"
  ],
  "palettes": [
    "neutral",
    "teal",
    "cobalt",
    "lime"
  ]
}
