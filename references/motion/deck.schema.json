{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Slides editable content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "motion"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "en",
            "zh"
          ],
          "default": "en"
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ],
          "default": 30
        },
        "brandName": {
          "type": "string"
        },
        "showLogo": {
          "type": "boolean",
          "description": "List identity is shown by default; false only when the user explicitly requests no logo."
        },
        "logo": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "\\.(svg|png|jpe?g|webp)$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string"
                },
                "fit": {
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "position": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?% [0-9]+(\\.[0-9]+)?%$"
                },
                "variants": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "light": {
                      "type": "string",
                      "pattern": "\\.(svg|png|jpe?g|webp)$"
                    },
                    "dark": {
                      "type": "string",
                      "pattern": "\\.(svg|png|jpe?g|webp)$"
                    }
                  }
                }
              },
              "required": [
                "src"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "light": {
                  "$ref": "#/$defs/image"
                },
                "dark": {
                  "$ref": "#/$defs/image"
                }
              }
            }
          ]
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        "palette": {
          "enum": [
            "neutral",
            "teal",
            "cobalt",
            "lime"
          ],
          "default": "neutral"
        }
      },
      "required": [
        "title"
      ]
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slide"
      },
      "minItems": 1
    }
  },
  "required": [
    "meta",
    "slides"
  ],
  "$defs": {
    "image": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\.(svg|png|jpe?g|webp)$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "fit": {
              "enum": [
                "contain",
                "cover"
              ]
            },
            "position": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?% [0-9]+(\\.[0-9]+)?%$"
            },
            "variants": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "light": {
                  "type": "string",
                  "pattern": "\\.(svg|png|jpe?g|webp)$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "\\.(svg|png|jpe?g|webp)$"
                }
              }
            }
          },
          "required": [
            "src"
          ]
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "tone": {
          "enum": [
            "standard",
            "muted",
            "accent",
            "neutral",
            "info",
            "success",
            "warning",
            "purple"
          ]
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "checked": {
          "type": "boolean"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "talk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition": {
          "type": "string"
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "enum": [
            "motion-title",
            "motion-brand",
            "motion-cards",
            "motion-comparison",
            "motion-input",
            "motion-list",
            "motion-synthesis",
            "motion-hub",
            "motion-image",
            "motion-metric",
            "motion-workflow"
          ]
        },
        "variant": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kicker": {
          "type": "string"
        },
        "highlight": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/tag"
            },
            "minItems": 1,
            "maxItems": 4
          },
          "minItems": 1,
          "maxItems": 4
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "description": "Synthesis composition. Omitted values use aligned, equal-width, centered medium peer tags, never a per-column size ramp.",
          "properties": {
            "arrangement": {
              "enum": [
                "columns",
                "rows",
                "wrap"
              ]
            },
            "size": {
              "enum": [
                "small",
                "medium",
                "large"
              ]
            },
            "outputSize": {
              "enum": [
                "small",
                "medium",
                "large"
              ]
            },
            "tagWidth": {
              "enum": [
                "fill",
                "hug"
              ]
            },
            "align": {
              "enum": [
                "left",
                "center"
              ]
            },
            "groupAlign": {
              "enum": [
                "start",
                "center"
              ]
            },
            "density": {
              "enum": [
                "comfortable",
                "compact"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "arrangement": {
                    "const": "wrap"
                  }
                },
                "required": [
                  "arrangement"
                ]
              },
              "then": {
                "properties": {
                  "tagWidth": {
                    "const": "hug"
                  }
                }
              }
            }
          ]
        },
        "hub": {
          "$ref": "#/$defs/item"
        },
        "logos": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/image"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "placeholder"
                ],
                "properties": {
                  "placeholder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 48
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 2
        },
        "separator": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "background": {
          "enum": [
            "content",
            "title",
            "elements",
            "brand",
            "brand-gradient"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0.016666666666666666,
          "maximum": 180,
          "description": "At least one frame at meta.fps (validated by generator); advisory only, explicit values override layout defaults."
        },
        "showLogo": {
          "type": "boolean",
          "description": "List-page override of meta.showLogo."
        },
        "showCursor": {
          "type": "boolean"
        },
        "showSend": {
          "type": "boolean"
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enter": {
              "type": "number",
              "minimum": 0
            },
            "stagger": {
              "type": "number",
              "minimum": 0
            },
            "hold": {
              "type": "number",
              "minimum": 0
            },
            "exit": {
              "type": "number",
              "minimum": 0
            },
            "travel": {
              "type": "number",
              "minimum": 0
            },
            "preset": {
              "enum": [
                "rise",
                "fade",
                "none"
              ]
            }
          },
          "description": "Legacy advisory metadata only. No native animation is applied."
        },
        "scroll": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "reveal": {
              "enum": [
                "sequential",
                "all"
              ]
            },
            "direction": {
              "const": "up"
            },
            "itemDirection": {
              "enum": [
                "up",
                "down",
                "fade"
              ]
            },
            "itemOrder": {
              "enum": [
                "top-to-bottom",
                "bottom-to-top"
              ],
              "default": "top-to-bottom"
            }
          },
          "description": "Advisory choreography only. The entire slide is the camera; no internal scroll viewport or distance is prescribed."
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "send": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "default",
                "hover",
                "pressed",
                "sent",
                "disabled"
              ]
            },
            "ariaLabel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "connections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "slot": {
                "enum": [
                  "top-left",
                  "top-right",
                  "bottom-left",
                  "bottom-right",
                  "bottom"
                ]
              }
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 40
            },
            "caption": {
              "type": "string",
              "maxLength": 120
            },
            "image": {
              "$ref": "#/$defs/image"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "maxLength": 24
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "maxLength": 32
                }
              }
            },
            "type": {
              "enum": [
                "table",
                "list"
              ]
            },
            "columnWidths": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "accentColumn": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "list"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "required": [
                  "items"
                ]
              },
              "else": {
                "required": [
                  "columns",
                  "rows"
                ]
              }
            }
          ]
        },
        "theme": {
          "enum": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        "showCaret": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/item"
                }
              }
            }
          }
        },
        "palette": {
          "enum": [
            "neutral",
            "teal",
            "cobalt",
            "lime"
          ],
          "default": "neutral"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-title"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "statement",
                  "brand-title"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "variant": {
                      "const": "brand-title"
                    }
                  },
                  "required": [
                    "variant"
                  ]
                },
                "then": {
                  "required": [
                    "logos"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-brand"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "logos"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "single",
                  "pair"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-cards"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "items"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "standard"
                ]
              },
              "items": {
                "minItems": 2,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-comparison"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "items"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "before-after"
                ]
              },
              "items": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "prompt"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "multiline",
                  "compact"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "plain",
                  "checked"
                ]
              },
              "items": {
                "minItems": 1,
                "maxItems": 24
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-synthesis"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "groups",
              "outputs"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "stages",
                  "many-to-few"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-hub"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "items",
              "hub"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "one",
                  "two",
                  "three",
                  "four"
                ]
              },
              "items": {
                "minItems": 1,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "image"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "split",
                  "hero"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-metric"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title",
              "value"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "single"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "motion-workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "title"
            ],
            "properties": {
              "variant": {
                "enum": [
                  "left-to-right",
                  "rows"
                ]
              },
              "items": {
                "minItems": 2,
                "maxItems": 4
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "variant": {
                      "const": "rows"
                    }
                  },
                  "required": [
                    "variant"
                  ]
                },
                "then": {
                  "required": [
                    "rows"
                  ]
                },
                "else": {
                  "required": [
                    "items"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "purple",
            "accent"
          ]
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      }
    }
  }
}
