          "id": "research",
          "items": [
            {
              "id": "owner",
              "label": "负责人",
              "title": "研究"
            },
            {
              "id": "task",
              "label": "任务",
              "title": "发现信号"
            },
            {
              "id": "result",
              "label": "结果",
              "title": "简报"
            }
          ]
        },
        {
          "id": "operations",
          "items": [
            {
              "id": "owner",
              "label": "负责人",
              "title": "运营"
            },
            {
              "id": "task",
              "label": "任务",
              "title": "分配工作"
            },
            {
              "id": "result",
              "label": "结果",
              "title": "队列"
            }
          ]
        },
        {
          "id": "review",
          "items": [
            {
              "id": "owner",
              "label": "负责人",
              "title": "审核"
            },
            {
              "id": "task",
              "label": "任务",
              "title": "核验事实"
            },
            {
              "id": "result",
              "label": "结果",
              "title": "决策"
            }
          ]
        }
      ],
      "palette": "cobalt",
      "background": "brand"
    },
    {
      "id": "dark-tags",
      "type": "motion-synthesis",
      "title": "从信息信号到行动",
      "groups": [
        [
          {
            "title": "研究",
            "tone": "info"
          },
          {
            "title": "反馈",
            "tone": "info"
          }
