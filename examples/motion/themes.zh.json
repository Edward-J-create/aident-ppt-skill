        "accentColumn": 1,
        "rows": [
          [
            "信号甲",
            "就绪",
            "研究"
          ],
          [
            "信号乙",
            "审核中",
            "运营"
          ]
        ]
      }
    },
    {
      "id": "result-list",
      "type": "motion-synthesis",
      "theme": "light",
      "title": "清晰而简短的交接",
      "groups": [
        [
          {
            "title": "证据",
            "tone": "info"
          },
          {
            "title": "上下文",
            "tone": "info"
          }
        ]
      ],
      "outputs": [],
      "result": {
        "type": "list",
        "title": "下一步行动",
        "items": [
          "明确一位负责人",
          "设定下一个检查点",
          "分享已核验的结果"
        ]
      },
      "palette": "teal",
      "background": "brand"
    },
    {
      "id": "dark-list",
      "type": "motion-list",
      "items": [
        {
          "title": "汇集可靠信号",
          "body": "让证据进入共享视图。",
          "tools": [
            {
              "src": "assets/motion/mark.svg",
              "alt": "可替换工具"
            }
          ]
        },
        {
          "title": "明确下一步行动",
          "body": "让责任归属和标准始终可见。",
          "badge": "就绪"
        },
        {
          "title": "发布之前先核验",
          "body": "指定一位明确的审核负责人。"
        }
      ],
      "palette": "lime",
      "background": "brand-gradient"
    },
    {
      "id": "dark-comparison",
      "type": "motion-comparison",
      "title": "从分散到协同",
      "items": [
        {
          "title": "分散的工作",
          "tone": "muted",
          "label": "之前",
          "body": "上下文不断交接，却没有明确的负责人。"
        },
        {
          "title": "共同的方向",
          "tone": "accent",
          "label": "之后",
          "body": "让证据与责任归属一起流转。"
        }
      ],
      "palette": "cobalt",
      "background": "brand-gradient"
    },
    {
      "id": "dark-metric",
      "type": "motion-metric",
      "theme": "light",
      "palette": "lime",
      "title": "一个清晰的下一步",
      "value": "1",
      "label": "示例数据",
      "body": "聚焦的行动更容易核验。"
    },
    {
      "id": "brand-statement",
      "type": "motion-title",
      "palette": "teal",
      "background": "brand-gradient",
      "title": "把清晰想法变成行动",
      "highlight": "行动"
    },
    {
      "id": "brand-input",
      "type": "motion-input",
      "palette": "cobalt",
      "background": "brand-gradient",
      "prompt": "找到可靠的证据。\n给出一个明确的建议。",
      "showCaret": true,
      "send": {
        "state": "sent"
      }
    }
  ]
}
