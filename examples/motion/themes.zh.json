{
  "meta": {
    "mode": "motion",
    "title": "动态镜头主题与组合",
    "language": "zh",
    "theme": "dark"
  },
  "slides": [
    {
      "id": "brand-title",
      "type": "motion-title",
      "variant": "brand-title",
      "theme": "light",
      "title": "让每次行动\n都有意义",
      "body": "清晰的想法，可编辑的视觉系统。",
      "logos": [
        {
          "src": "assets/motion/lockup.svg",
          "alt": "Aident Loadout"
        },
        {
          "placeholder": "你的 Logo"
        }
      ]
    },
    {
      "id": "dark-input",
      "type": "motion-input",
      "variant": "compact",
      "prompt": "找到一个有价值的下一步。",
      "image": {
        "src": "assets/motion/mark.svg",
        "alt": "Aident"
      },
      "showCaret": true,
      "showCursor": true,
      "send": {
        "state": "hover"
      }
    },
    {
      "id": "dark-hub",
